# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Session Tokens
JWT_SECRET="replace_with_a_secure_random_64_character_hex_secret"

# Server Port
PORT=5000
